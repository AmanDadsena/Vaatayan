# Copy to .env.local and fill in. Never commit real keys.
# Set ONE of these for AI-written plans and answers. Without a key the app
# still works fully, using its built-in planner and answer engine.
# If both are set, Anthropic is used.

ANTHROPIC_API_KEY=
# AI_MODEL=

# Google Gemini (Gemini Developer API key from Google AI Studio or Cloud).
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Public address of the deployed site, for link previews (e.g. https://vaatayan.example).
# NEXT_PUBLIC_SITE_URL=
