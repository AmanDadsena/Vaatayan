{
  "name": "vaatayan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run lint:dupes && npm run lint:unused && npm run typecheck && npm run test:coverage && npm run build",
    "lint:dupes": "jscpd src",
    "lint:unused": "knip --no-progress"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@google/genai": "^3.6.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jscpd": "^4.3.0",
    "jsdom": "^31.0.1",
    "knip": "^5.88.1",
    "prettier": "^3.10.1",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
